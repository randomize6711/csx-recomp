+// the frame buffers NewFrameBuffers made; the GPU must be done with them
+void FreeFrameBuffers() {
+    auto free_surface = [](uint32_t hdr) {
+        if (!hdr) return;
+        mem::FreeContiguous(mem::VirtualFromPhysical(R32(hdr + 4)));
+        mem::FreeSystem(hdr);
+    };
+    for (uint32_t i = 0; i < g_buffer_count; i++) free_surface(std::exchange(g_buffers[i], 0));
+    free_surface(std::exchange(g_depth, 0));
+}
