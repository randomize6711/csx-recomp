+// Reset as the library does it: the old frame buffers go, new ones as the parameters ask, then the back buffer and
+// the automatic depth buffer become the render target and are cleared (SetRenderTarget, Clear with target and Z)
+HLE_STDCALL(D3DDevice_Reset, 1) {
+    std::lock_guard<std::recursive_mutex> lock(g_lock);
+    uint32_t pp = a[0];
+    LogPresentParameters("Reset", pp);
+    if (g_backend) g_backend->Flush();
+    FreeFrameBuffers();
+    uint32_t w = 0, h = 0;
+    NewFrameBuffers(pp, w, h);
+    SetFrameBufferFields();
+    GUEST_CALL(D3DDevice_SetRenderTarget, ctx, {g_buffers[1], g_depth});
+    GUEST_CALL(D3DDevice_Clear, ctx, {0, 0, 3, 0, 0x3F800000u, 0});  // D3DCLEAR_TARGET | D3DCLEAR_ZBUFFER, z 1.0
+    return 0;
+}
