+// (pPushBuffer in edi): host draws until EndPushBuffer go to its recording
+HLE_STDCALL(D3DDevice_BeginPushBuffer, 1) {
+    std::lock_guard<std::recursive_mutex> lock(g_lock);
+    SyncDeferred();
+    g_recording = &g_push_buffers[a[0]];
+    g_recording->clear();
+    g_record_base = g_state;
+    g_touched.assign(g_touched.size(), false);
+    g_touching = true;
+    return 0;
+}
+
+HLE_STDCALL(D3DDevice_EndPushBuffer, 0) {
+    std::lock_guard<std::recursive_mutex> lock(g_lock);
+    if (g_recording) LOG_FIRST(8, "d3d: push buffer recorded, %zu draws", g_recording->size());
+    g_recording = nullptr;
+    g_touching = false;
+    return 0;
+}
+
+// (pPushBuffer, pFixup): the recording drawn over the current state, which is put back afterwards (the library
+// does not track what a push buffer sets)
+HLE_STDCALL(D3DDevice_RunPushBuffer, 2) {
+    std::lock_guard<std::recursive_mutex> lock(g_lock);
+    if (a[1]) LOG_FIRST(1, "d3d: RunPushBuffer fixups are not applied");
+    auto it = g_push_buffers.find(a[0]);
+    if (it == g_push_buffers.end() || !g_backend) return 0;
+    SyncDeferred();
+    gpu::State saved = g_state;
+    std::vector<uint32_t*> now = StateWords(g_state), was = StateWords(saved);
+    const std::vector<std::pair<uint32_t, uint32_t>>* prev = nullptr;
+    for (const RecordedDraw& d : it->second) {
+        if (prev)
+            for (auto& [i, v] : *prev) *now[i] = *was[i];
+        for (auto& [i, v] : d.words) *now[i] = v;
+        prev = &d.words;
+        if (&d == &it->second.front() || d.render != (&d - 1)->render) {
+            g_state.simple = d.render->simple;
+            g_state.rs = d.render->rs;
+            g_state.tss = d.render->tss;
+        }
+        g_state.streams = d.streams;
+        g_state.textures = d.textures;
+        g_state.palettes = d.palettes;
+        g_state.index_buffer = d.index_buffer, g_state.index_data = d.index_data, g_state.base_vertex = d.base_vertex;
+        g_state.vs_handle = d.vs_handle;
+        g_state.vs = d.vs;
+        g_state.ps = d.ps;
+        if (!d.up.empty()) {
+            g_state.streams[0] = {UpVertices(d.up.data(), uint32_t(d.up.size())), d.up_stride};
+            g_backend->Draw(g_state, d.prim, 0, d.count, nullptr);
+        } else {
+            g_backend->Draw(g_state, d.prim, d.start, d.count, d.indices.empty() ? nullptr : d.indices.data());
+        }
+    }
+    g_state = saved;
+    return 0;
+}
