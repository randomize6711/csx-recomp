+// Push buffers: CS records its world (BeginPushBuffer .. EndPushBuffer at load) and replays it every frame
+// (RunPushBuffer) after setting the camera constants. The host draws go to a recording instead of the backend. A
+// recorded draw keeps its render states, streams, indices, textures and shaders as they were, and of the other state
+// (constants, transforms, lights) the words the recording wrote or changed against the state at BeginPushBuffer; a
+// replay applies those over the state of the moment, so constants set before RunPushBuffer (the camera) stay. The
+// target, depth buffer, viewport and super sample scale stay the current ones (the back buffers alternate).
+namespace {
+struct RenderStates {
+    decltype(gpu::State::simple) simple;
+    decltype(gpu::State::rs) rs;
+    decltype(gpu::State::tss) tss;
+    bool operator==(const RenderStates&) const = default;
+};
+struct RecordedDraw {
+    std::vector<std::pair<uint32_t, uint32_t>> words;  // index into StateWords, value
+    // render states as they were when the draw was recorded, shared by consecutive draws with the same ones: replays
+    // drawn over the render states of the moment came out black (the frame start resets textures stages and render
+    // states before RunPushBuffer), drawn with the recorded ones they match the scene
+    std::shared_ptr<const RenderStates> render;
+    // what the draw reads its vertices, indices and textures from, always as recorded: a recording may set them to
+    // what the state already held, which a comparison with the state at BeginPushBuffer would miss
+    std::array<gpu::State::Stream, 16> streams{};
+    std::array<uint32_t, 4> textures{}, palettes{};
+    uint32_t index_buffer = 0, index_data = 0, base_vertex = 0;
+    uint32_t vs_handle = 0;
+    std::shared_ptr<gpu::VertexShader> vs;
+    std::shared_ptr<gpu::PixelShader> ps;
+    uint32_t prim = 0, start = 0, count = 0;
+    std::vector<uint8_t> indices;  // 16 bit indices, copied
+    std::vector<uint8_t> up;       // DrawVerticesUP and immediate vertices, copied
+    uint32_t up_stride = 0;
+};
+std::unordered_map<uint32_t, std::vector<RecordedDraw>> g_push_buffers;  // by guest D3DPushBuffer
+std::vector<RecordedDraw>* g_recording = nullptr;
+gpu::State g_record_base;
+
+// true when a recording took the draw
+bool RecordDraw(uint32_t prim, uint32_t start, uint32_t count, const uint8_t* indices, const void* up, uint32_t stride) {
+    if (!g_recording) return false;
+    static std::vector<uint32_t*> now, base;
+    now = StateWords(g_state);
+    base = StateWords(g_record_base);
+    RecordedDraw d;
+    for (size_t i = 0; i < now.size(); i++)
+        if (*now[i] != *base[i] || (i < g_touched.size() && g_touched[i])) d.words.emplace_back(uint32_t(i), *now[i]);
+    RenderStates rs{g_state.simple, g_state.rs, g_state.tss};
+    if (!g_recording->empty() && *g_recording->back().render == rs) d.render = g_recording->back().render;
+    else d.render = std::make_shared<const RenderStates>(rs);
+    d.streams = g_state.streams;
+    d.textures = g_state.textures;
+    d.palettes = g_state.palettes;
+    d.index_buffer = g_state.index_buffer, d.index_data = g_state.index_data, d.base_vertex = g_state.base_vertex;
+    d.vs_handle = g_state.vs_handle;
+    d.vs = g_state.vs;
+    d.ps = g_state.ps;
+    d.prim = prim, d.start = start, d.count = count;
+    if (indices) d.indices.assign(indices, indices + count * 2);
+    if (up) {
+        d.up.assign(static_cast<const uint8_t*>(up), static_cast<const uint8_t*>(up) + count * stride);
+        d.up_stride = stride;
+    }
+    g_recording->push_back(std::move(d));
+    return true;
+}
+}  // namespace
