 namespace {
 
+// the state's plain words a recording can change, region by region in a fixed order
+template <typename F>
+void ForStateWords(gpu::State& s, F f) {
+    f(reinterpret_cast<uint32_t*>(s.vsc.data()), s.vsc.size() * 4);
+    f(reinterpret_cast<uint32_t*>(s.psc.data()), s.psc.size() * 4);
+    f(&s.scissor_count, 1);
+    f(s.scissors.data(), s.scissors.size());
+    f(reinterpret_cast<uint32_t*>(s.transforms.data()), s.transforms.size() * 16);
+    f(reinterpret_cast<uint32_t*>(s.material.data()), s.material.size());
+    f(s.lights[0].data(), s.lights.size() * 26);
+    f(&s.light_enable, 1);
+}
+static_assert(sizeof(float) == 4);
+
+std::vector<uint32_t*> StateWords(gpu::State& s) {
+    std::vector<uint32_t*> w;
+    ForStateWords(s, [&](void* p, size_t n) {
+        for (size_t i = 0; i < n; i++) w.push_back(static_cast<uint32_t*>(p) + i);
+    });
+    return w;
+}
+
+// push buffer recording: the state words host entry points wrote since BeginPushBuffer, recorded even when they hold
+// what the state held then (a recording that sets a value again must replay it)
+bool g_touching = false;
+std::vector<bool> g_touched;
+void Touch(const void* p, size_t bytes) {
+    if (!g_touching) return;
+    static std::unordered_map<const uint32_t*, uint32_t> index;
+    if (index.empty()) {
+        std::vector<uint32_t*> w = StateWords(g_state);
+        for (uint32_t i = 0; i < w.size(); i++) index[w[i]] = i;
+    }
+    g_touched.resize(index.size());
+    const uint32_t* w = static_cast<const uint32_t*>(p);
+    for (size_t i = 0; i < bytes / 4; i++) {
+        auto it = index.find(w + i);
+        if (it != index.end()) g_touched[it->second] = true;
+    }
+}
