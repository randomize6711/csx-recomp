-        else ctx.*kReg[m.loc[i]] = v;
+        else if (m.loc[i] != none) ctx.*kReg[m.loc[i]] = v;
         i++;
     }
     uint32_t r = ::kernel::CallGuest(ctx, fn, pushed, n);
