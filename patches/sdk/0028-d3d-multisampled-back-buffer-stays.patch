+// a multisampled back buffer (larger than the display): resolved at Swap, it stays the render target's memory
+bool Multisampled() { return g_bb_scale[0] != 1.0f || g_bb_scale[1] != 1.0f; }
+
+// the buffer holding what was presented last: the front buffer, or the multisampled back buffer that is not rotated
+uint32_t ShownBuffer() { return Multisampled() ? g_buffers[1] : g_buffers[0]; }
+
 // the front, back and automatic depth buffers a D3DPRESENT_PARAMETERS asks for; w and h get the size used
