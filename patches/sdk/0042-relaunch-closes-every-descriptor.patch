@@ -207,6 +209,11 @@ void Relaunch(const char* exe) {
     path = path.substr(0, path.find_last_of('/') + 1) + exe;
     // the new image binds the same ports: the sockets are closed here as on Windows (they are close-on-exec too)
     xnet::CloseSockets();
