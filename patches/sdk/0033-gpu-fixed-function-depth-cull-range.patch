 }
 
+// the lazy state setup (5659 0x304884) sets NV097_SET_CLIP_MIN / MAX to MinZ and MaxZ times the Z scale for the fixed
+// function, 0 and the Z scale for vertex programs and the W buffer (ZEnable 2); D3DRS_DEPTHCLIPCONTROL's
+// D3DDCC_CULLPRIMITIVE (bit 0) culls outside it. A reversed range (MaxZ below MinZ) is left to 0 to zscale.
+bool FixedDepthCullRange(const State& s, float& lo, float& hi) {
+    constexpr uint32_t kWBuffer = 2, kCullPrimitive = 1;
+    const auto& v = s.viewport;
+    if (s.rs[kRsZEnable] == kWBuffer || !(SimpleState(s, kMDepthClipControl) & kCullPrimitive)) return false;
+    if (!(v.min_z < v.max_z) || (v.min_z == 0 && v.max_z == 1)) return false;
+    lo = v.min_z * s.zscale;
+    hi = v.max_z * s.zscale;
+    return true;
+}
