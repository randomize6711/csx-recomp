@@ -47,6 +47,21 @@
     return m;
 }
 
-void Pace() {}
+// FPS=N paces presented frames to N per second (unset or 0: as fast as they come), so pad scripts and scenarios keyed
+// to frames see the title at a console-like rate
+void Pace() {
+    static const long fps = [] {
+        const char* e = std::getenv("FPS");
+        return e ? std::atol(e) : 0L;
+    }();
+    if (fps <= 0) return;
+    using clock = std::chrono::steady_clock;
+    static clock::time_point next = clock::now();
+    auto period = std::chrono::nanoseconds(1000000000LL / fps);
+    auto now = clock::now();
+    next += period;
+    if (next < now - period) next = now;
+    std::this_thread::sleep_until(next);
+}
 
 }  // namespace app
