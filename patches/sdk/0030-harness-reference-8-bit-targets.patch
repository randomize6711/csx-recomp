 private:
+    // an 8 bit linear target (LIN_L8) is one a title reads on the CPU, e.g. a measurement of the frame (Counter-Strike's
+    // dynamic gamma): drawn on every frame, small, so the title never reads a target only cleared since the last drawn
+    // frame (it samples what the last drawn frame left in guest memory)
+    static bool ReadByCpu(const Surface& rt) {
+        TextureDesc d;
+        return rt.header && DescribeSurface(rt, d) && d.linear && Format(d.format).bits == 8;
+    }
