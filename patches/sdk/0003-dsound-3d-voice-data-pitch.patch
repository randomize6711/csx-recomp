+// 3D voice data, pitch, LFO, envelopes and voice properties (XDK 5659, used by XACT)
+namespace {
+// (voice, block): block dword 0 selects which groups of the dwords +0x04..+0x34 the voice keeps
+uint32_t Set3DVoiceData(Voice& v, uint32_t block) {
+    uint32_t f = R32(block);
+    if (!v.vd3d || !(f & 0xFF)) return 0;
+    static const uint8_t kFirst[8] = {0, 1, 2, 4, 6, 8, 9, 11}, kCount[8] = {1, 1, 2, 2, 2, 1, 2, 2};
+    for (int g = 0; g < 8; g++)
+        if (f >> g & 1)
+            for (int k = 0; k < kCount[g]; k++) v.d3[kFirst[g] + k] = int32_t(R32(block + 4 + (kFirst[g] + k) * 4));
+    if (f & 0x40) v.azimuth_set = true;
+    return 0;
+}
+// DSVOICEPROPS (0x5C bytes): mix bins and their levels, pitch, the 3D levels
+uint32_t GetVoiceProperties(const Voice& v, uint32_t out) {
+    std::memset(HostPtr(out), 0, 0x5C);
+    static const uint8_t kFront[2] = {0, 1};
+    uint32_t n = v.nbins ? v.nbins : 2;
+    W32(out, n);
+    for (uint32_t i = 0; i < 8; i++) {
+        bool used = i < n;
+        uint32_t b = used ? (v.nbins ? v.bin[i] : kFront[i]) : 0xFFFFFFFF;
+        int32_t mb = used ? std::clamp(v.bin_mb[b] + int32_t(std::lround(2000.0 * std::log10(std::max(v.volume, 1e-5f)))), -10000, 0) : -10000;
+        W32(out + 4 + i * 8, b);
+        W32(out + 8 + i * 8, uint32_t(mb));
+    }
+    W32(out + 0x44, uint32_t(int32_t(std::lround(4096.0 * std::log2(PlaybackRate(v) / 48000.0)))));
+    bool on = v.use3d && v.vd3d;
+    W32(out + 0x48, on ? uint32_t(v.d3[0]) : 0);
+    W32(out + 0x4C, on ? uint32_t(v.d3[1]) : 0);
+    W32(out + 0x50, on ? uint32_t(v.d3[8]) : 0);
+    W32(out + 0x54, on ? uint32_t(v.d3[6]) : 0);
+    W32(out + 0x58, on ? uint32_t(v.d3[7]) : 0);
+    return 0;
+}
+}  // namespace
