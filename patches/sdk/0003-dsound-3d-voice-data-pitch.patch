+// the level a 3D voice data block adds to mix bin b, mB: distance and cone volume on every bin, the front/back and
+// azimuth terms on the 3D bins and the I3DL2 direct and room volumes (as the voice update 0x24AF4E of 5659 does)
+int32_t VoiceData3DLevel(const Voice& v, uint32_t b) {
+    auto clamp = [](int32_t x) { return std::clamp(x, -10000, 0); };
+    const int32_t* d = v.d3;
+    int32_t dist = clamp(clamp(d[0]) + clamp(d[1]));
+    switch (b) {
+        case 2: return clamp(clamp(d[6]) + clamp(d[5]) + clamp(d[2]) + dist);
+        case 6: case 7: return clamp(clamp(d[6]) + clamp(d[4]) + clamp(d[2]) + dist);
+        case 8: case 9: return clamp(clamp(d[6]) + clamp(d[3]) + dist);
+        case 10: return clamp(clamp(d[7]) + dist);
+        default: return dist;
+    }
+}
