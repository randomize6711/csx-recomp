+// playback rate in Hz: the pitch a title set or the frequency or format rate, plus 3D Doppler pitch
+double PlaybackRate(const Voice& v) {
+    double hz = v.pitch_set ? 48000.0 * std::exp2(v.pitch / 4096.0) : double(v.freq ? v.freq : v.rate);
+    if (v.use3d && v.vd3d && v.d3[8]) hz *= std::exp2(std::clamp(v.d3[8], -32767, 8191) / 4096.0);
