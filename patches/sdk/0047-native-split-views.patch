+struct SplitView {
+    bool on = false;
+    int player = 0;             // whose frame (0..3)
+    int views = 1;              // the views of this window frame
+    bool first = true;          // the window frame's first view: the window cleared (black) before it
+    bool last = true;           // its last: the window frame presented after it
+    float x = 0, y = 0, w = 1, h = 1;  // the viewport in the window, in fractions of its size
+    float frame_w = 1, frame_h = 1;     // the configured layout's view size (fractions): the internal resolution's
+};
