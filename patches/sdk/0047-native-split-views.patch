+namespace {
+gpu::SplitView g_view;          // the view the next Swap is
+bool g_view_swapped = false;    // a Swap of this view happened (a second one repeats it)
+bool g_frame_open = false;      // a window frame's first view was placed, its last not yet presented
+SplitCounters g_split{};
+}  // namespace
+
+void SetSplitView(const gpu::SplitView& v) {
+    std::lock_guard<std::recursive_mutex> lock(g_lock);
+    g_view = v;
+    g_view_swapped = false;
+}
+
+bool FinishSplitFrame() {
+    std::lock_guard<std::recursive_mutex> lock(g_lock);
+    g_view.on = false;
+    if (!g_frame_open) return false;
+    g_frame_open = false;
+    g_split.finished++;
+    if (g_backend && g_backend->ComposesViews()) g_backend->FinishViews();
+    return true;
+}
+
+SplitCounters SplitStats() {
+    std::lock_guard<std::recursive_mutex> lock(g_lock);
+    return g_split;
