+// the overlay as the backend gets it with each Present: the source rectangle of the overlay surface decoded to BGRA
+// (YUY2, the movies' format, as the console's overlay converts it: ITU-R BT.601 with studio range; 32 bit RGB copied)
+void PassOverlay() {
+    static std::vector<uint32_t> pixels;
+    gpu::OverlayImage o;
+    uint32_t h = g_overlay.surface;
+    if (g_overlay.enabled && h) {
+        uint32_t fmt = R32(h + 12) >> 8 & 0xFF, size = R32(h + 16);
+        uint32_t w = (size & 0xFFF) + 1, ht = (size >> 12 & 0xFFF) + 1, pitch = ((size >> 24) + 1) * 64;
+        uint32_t data = mem::VirtualFromPhysical(R32(h + 4));
+        int32_t sx0 = std::clamp<int32_t>(g_overlay.src[0], 0, int32_t(w)), sy0 = std::clamp<int32_t>(g_overlay.src[1], 0, int32_t(ht));
+        int32_t sx1 = std::clamp<int32_t>(g_overlay.src[2], sx0, int32_t(w)), sy1 = std::clamp<int32_t>(g_overlay.src[3], sy0, int32_t(ht));
+        o.width = uint32_t(sx1 - sx0);
+        o.height = uint32_t(sy1 - sy0);
+        pixels.resize(size_t(o.width) * o.height);
+        auto clip = [](int v) { return uint32_t(std::clamp(v, 0, 255)); };
+        bool known = true;
+        for (uint32_t y = 0; y < o.height && known; y++) {
+            const uint8_t* row = static_cast<const uint8_t*>(HostPtr(data + (uint32_t(sy0) + y) * pitch));
+            for (uint32_t x = 0; x < o.width; x++) {
+                uint32_t sx = uint32_t(sx0) + x;
+                uint32_t& out = pixels[size_t(y) * o.width + x];
+                if (fmt == 0x24) {  // YUY2: Y0 U Y1 V per pixel pair
+                    const uint8_t* q = row + (sx & ~1u) * 2;
+                    int c = int(q[(sx & 1) * 2]) - 16, d = int(q[1]) - 128, e = int(q[3]) - 128;
+                    out = 0xFF000000 | clip((298 * c + 409 * e + 128) >> 8) << 16 |
+                          clip((298 * c - 100 * d - 208 * e + 128) >> 8) << 8 | clip((298 * c + 516 * d + 128) >> 8);
+                } else if (fmt == 0x12 || fmt == 0x1E) {  // linear A8R8G8B8 / X8R8G8B8
+                    std::memcpy(&out, row + sx * 4, 4);
+                    out |= 0xFF000000;
+                } else {
+                    known = false;
+                    break;
+                }
+            }
+        }
+        if (known) {
+            o.enabled = true;
+            o.pixels = pixels.data();
+            for (int i = 0; i < 4; i++) o.dst[i] = g_overlay.dst[i];
+            uint32_t fs = R32(g_buffers[1] + 16);
+            o.display_w = uint32_t(float((fs & 0xFFF) + 1) / g_bb_scale[0]);
+            o.display_h = uint32_t(float((fs >> 12 & 0xFFF) + 1) / g_bb_scale[1]);
+            o.use_color_key = g_overlay.use_color_key;
+            o.color_key = g_overlay.color_key;
+        } else {
+            LOG_FIRST(1, "d3d: overlay format %02X is not shown", fmt);
+        }
+    }
+    g_backend->SetOverlay(o);
+}
