+void CompositeOverlay(const OverlayImage& o, uint32_t* image, uint32_t w, uint32_t h, uint32_t pitch) {
+    if (!o.enabled || !o.pixels || !o.width || !o.height || !o.display_w || !o.display_h) return;
+    float sx = float(w) / o.display_w, sy = float(h) / o.display_h;
+    int x0 = std::max(0, int(o.dst[0] * sx)), y0 = std::max(0, int(o.dst[1] * sy));
+    int x1 = std::min(int(w), int(o.dst[2] * sx)), y1 = std::min(int(h), int(o.dst[3] * sy));
+    if (x1 <= x0 || y1 <= y0) return;
+    float ux = float(o.width) / float(x1 - x0), uy = float(o.height) / float(y1 - y0);
+    for (int y = y0; y < y1; y++) {
+        float fy = std::max(0.0f, (float(y - y0) + 0.5f) * uy - 0.5f);
+        uint32_t ya = std::min(uint32_t(fy), o.height - 1), yb = std::min(ya + 1, o.height - 1);
+        float ty = fy - float(ya);
+        for (int x = x0; x < x1; x++) {
+            uint32_t& dst = image[size_t(y) * pitch + uint32_t(x)];
+            if (o.use_color_key && (dst & 0xFFFFFF) != (o.color_key & 0xFFFFFF)) continue;
+            float fx = std::max(0.0f, (float(x - x0) + 0.5f) * ux - 0.5f);
+            uint32_t xa = std::min(uint32_t(fx), o.width - 1), xb = std::min(xa + 1, o.width - 1);
+            float tx = fx - float(xa);
+            const uint32_t* p = o.pixels;
+            uint32_t c00 = p[ya * o.width + xa], c01 = p[ya * o.width + xb], c10 = p[yb * o.width + xa], c11 = p[yb * o.width + xb];
+            uint32_t out = 0xFF000000;
+            for (int k = 0; k < 24; k += 8) {
+                float a = float(c00 >> k & 255) * (1 - tx) + float(c01 >> k & 255) * tx;
+                float b = float(c10 >> k & 255) * (1 - tx) + float(c11 >> k & 255) * tx;
+                out |= uint32_t(a * (1 - ty) + b * ty + 0.5f) << k;
+            }
+            dst = out;
+        }
+    }
+}
+
 }  // namespace gpu
